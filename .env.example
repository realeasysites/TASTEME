# Copy to .env for local dev. On Render, set these under Environment.

PORT=3000

# Admin dashboard (/admin). Login is disabled until ADMIN_PASSWORD is set.
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie.
SESSION_SECRET=

# Where new catering / event inquiries get emailed.
NOTIFY_EMAIL=

# SMTP sender (Gmail: smtp.gmail.com, port 465, use an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: where the SQLite file lives (use a Render persistent disk path, e.g. /var/data/tasteme.db)
DB_PATH=
